---
import PortalLayout from '../../layouts/PortalLayout.astro';
import RemotePage from '../../components/portal/RemotePage';
import { loadPortalProfile } from '../../lib/server';
import { withBase } from '../../lib/basePath';

const profile = await loadPortalProfile(Astro.request);
if (!profile) return Astro.redirect(withBase('/login'), 302);
if (profile.accessMode !== 'remote_only') return Astro.redirect(withBase('/quotes'), 302);
---

<PortalLayout title="Remote access" remoteOnly>
  <RemotePage client:load />
</PortalLayout>
