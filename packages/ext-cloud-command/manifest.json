{
  "apiVersion": "breeze.extensions/v1",
  "name": "cloudcommand",
  "version": "0.1.0",
  "routeNamespace": "cloud-command",
  "requires": {
    "breeze": ">=0.1.0 <0.2.0",
    "serverSdk": "^1.0.0",
    "webSdk": "^1.0.0",
    "capabilities": [
      "server.routes.v1",
      "web.pages.v1",
      "web.navigation.v1",
      "server.db.rls.v1",
      "server.secrets.v1",
      "server.audit.v1"
    ]
  },
  "server": {
    "entry": "server/index.cjs"
  },
  "web": {
    "entry": "web/index.js",
    "pages": [
      {
        "id": "overview",
        "path": "/overview",
        "element": "cloudcommand-overview-page"
      },
      {
        "id": "threecx",
        "path": "/threecx",
        "element": "cloudcommand-threecx-page"
      },
      {
        "id": "microsoft",
        "path": "/microsoft",
        "element": "cloudcommand-microsoft-page"
      }
    ],
    "navigation": [
      {
        "id": "overview",
        "label": "Cloud Command",
        "path": "/overview",
        "order": 100
      }
    ],
    "slots": []
  },
  "migrationsDir": "migrations",
  "schemaCompatibilityFloor": "0.1.0",
  "publicRoutes": [],
  "agentRoutes": false,
  "jobs": [],
  "aiTools": [],
  "tenancy": {
    "orgCascadeDeleteTables": [
      "cloudcommand_threecx_connections",
      "cloudcommand_microsoft_connections"
    ],
    "deviceCascadeDeleteTables": [],
    "deviceOrgDenormalizedTables": [],
    "nonTenantTables": [],
    "orgExportColumns": {
      "cloudcommand_threecx_connections": {
        "include": [
          "id",
          "org_id",
          "origin",
          "client_id",
          "department_id",
          "enabled",
          "version",
          "last_verified_at",
          "created_at",
          "updated_at"
        ],
        "exclude": [
          "secret_ciphertext"
        ]
      },
      "cloudcommand_microsoft_connections": {
        "include": [
          "id",
          "org_id",
          "tenant_id",
          "tenant_domain",
          "tenant_name",
          "enabled",
          "version",
          "created_at",
          "updated_at"
        ],
        "exclude": [
          "backend_identity"
        ]
      }
    }
  }
}
