{
  "version": 1,
  "customizations": [
    {
      "id": "rustdesk-desired-state",
      "requiredFiles": [
        "scripts/cloudcom/rustdesk/common.ps1",
        "scripts/cloudcom/rustdesk/probe.ps1",
        "scripts/cloudcom/rustdesk/repair.ps1",
        "scripts/cloudcom/rustdesk/build-upload.ps1",
        "scripts/cloudcom/rustdesk/test-contract.ps1",
        "scripts/cloudcom/rustdesk/repair.Tests.ps1",
        "scripts/cloudcom/rustdesk/README.md"
      ],
      "hooks": [
        {
          "file": ".github/workflows/cloudcom-ci.yml",
          "contains": "Invoke-Pester ./scripts/cloudcom/rustdesk/repair.Tests.ps1"
        },
        {
          "file": "scripts/cloudcom/rustdesk/common.ps1",
          "contains": "$quiet = Get-CloudComRustDeskQuietState $exe"
        },
        {
          "file": "scripts/cloudcom/rustdesk/repair.ps1",
          "contains": "Set-CloudComRustDeskQuietMode $state.Exe"
        }
      ]
    },
    {
      "id": "remote-access-alternatives",
      "requiredFiles": [
        "apps/api/src/routes/devices/cloudcomRemoteAccess.ts",
        "apps/api/src/routes/devices/cloudcomRemoteAccess.test.ts",
        "apps/api/src/services/cloudcom/remoteAccessOptions.ts",
        "apps/api/src/services/cloudcom/remoteAccessOptions.test.ts",
        "apps/web/src/components/cloudcom/RemoteAccessAlternatives.tsx",
        "apps/web/src/components/cloudcom/RemoteAccessAlternatives.test.tsx",
        "docs/cloudcom-rustdesk.md"
      ],
      "hooks": [
        {
          "file": "apps/api/src/routes/devices/index.ts",
          "contains": "deviceRoutes.route('/', cloudcomRemoteAccessRoutes)"
        },
        {
          "file": "apps/web/src/components/remote/RemoteToolsPage.tsx",
          "contains": "<RemoteAccessAlternatives"
        }
      ]
    },
    {
      "id": "browser-desktop",
      "requiredFiles": [
        "apps/web/src/components/cloudcom/browserDesktop/launch.tsx",
        "apps/web/src/components/cloudcom/browserDesktop/browserFetch.ts",
        "scripts/cloudcom/sync-browser-viewer.mjs",
        "docs/cloudcom-browser-desktop.md"
      ],
      "hooks": [
        {
          "file": "apps/web/src/components/remote/ConnectDesktopButton.tsx",
          "contains": "browserViewer.launchBrowserDesktop"
        },
        {
          "file": ".github/workflows/cloudcom-ci.yml",
          "contains": "sync-browser-viewer.mjs --check"
        }
      ]
    },
    {
      "id": "monitor-response-reference-fix",
      "requiredFiles": [
        "apps/api/src/services/monitors/monitorCompiler.ts",
        "apps/api/src/services/monitors/monitorCompiler.w04.test.ts"
      ],
      "hooks": [
        {
          "file": "apps/api/src/services/monitors/monitorCompiler.ts",
          "contains": "const diagnosticReferences = buildDiagnosticScriptReferences(def)"
        },
        {
          "file": ".github/workflows/cloudcom-ci.yml",
          "contains": "src/services/monitors/monitorCompiler.w04.test.ts"
        }
      ]
    },
    {
      "id": "cloud-command-threecx",
      "requiredFiles": [
        "packages/ext-cloud-command/manifest.json",
        "packages/ext-cloud-command/src/server/index.ts",
        "packages/ext-cloud-command/src/server/transport.ts",
        "packages/ext-cloud-command/src/web/index.ts",
        "packages/ext-cloud-command/src/web/connect.ts",
        "packages/ext-cloud-command/src/web/connect.test.ts",
        "packages/ext-cloud-command/migrations/2026-09-21-threecx-connections.sql",
        "apps/web/src/lib/extensions/hostApi.ts",
        "packages/extension-web-sdk/src/hostApi.ts",
        "docs/cloudcom-threecx.md"
      ],
      "hooks": [
        {
          "file": "apps/api/src/extensions/builtinRegistry.ts",
          "contains": "enableEnvVar: 'CLOUDCOM_THREECX_ENABLED'"
        },
        {
          "file": "apps/web/src/components/extensions/ExtensionElementHost.tsx",
          "contains": "createExtensionHostApi"
        },
        {
          "file": ".github/workflows/cloudcom-ci.yml",
          "contains": "scripts/cloudcom/test-threecx-rls.sh"
        },
        {
          "file": "apps/api/Dockerfile",
          "contains": "@cloudcom/ext-cloud-command build:web"
        }
      ]
    },
    {
      "id": "cloud-command-microsoft365",
      "requiredFiles": [
        "packages/ext-cloud-command/src/server/native-microsoft.ts",
        "apps/api/src/extensions/cloudCommandMicrosoft.ts",
        "packages/ext-cloud-command/src/server/microsoft.ts",
        "packages/ext-cloud-command/src/web/microsoft.ts",
        "packages/ext-cloud-command/migrations/2026-09-22-microsoft-connections.sql",
        "docs/cloudcom-microsoft365.md",
        "packages/ext-cloud-command/src/web/overview.ts",
        "packages/ext-cloud-command/src/web/overview.test.ts",
        "packages/ext-cloud-command/src/server/admin-services.ts",
        "packages/ext-cloud-command/src/server/admin-store.ts",
        "packages/ext-cloud-command/migrations/2026-09-22-native-admin-connections.sql",
        "apps/api/src/extensions/cloudCommandAdminRuntime.ts",
        "apps/api/src/extensions/cloudCommandAdminAuthorization.ts",
        "packages/ext-cloud-command/src/web/microsoft-connect.ts"
      ],
      "hooks": [
        {
          "file": "packages/ext-cloud-command/src/server/index.ts",
          "contains": "mountMicrosoftRoutes(app, administration ? createAdministrationServices(context, fetch, administration) : microsoft)"
        },
        {
          "file": "packages/ext-cloud-command/src/web/index.ts",
          "contains": "import './microsoft'"
        },
        {
          "file": "packages/ext-cloud-command/manifest.json",
          "contains": "cloudcommand-microsoft-page"
        },
        {
          "file": "packages/ext-cloud-command/manifest.json",
          "contains": "cloudcommand-connect-page"
        }
      ]
    }
  ]
}
