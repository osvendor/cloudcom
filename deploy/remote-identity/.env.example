# Copy to .env and keep the actual file out of version control.
# All published traffic terminates at the existing private reverse proxy.
AUTHENTIK_COMPOSE_PROJECT_NAME=cloudcom-authentik
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# These paths are read by Docker Compose as local secret files. Create the files
# with restrictive permissions; do not put their contents in this file.
AUTHENTIK_POSTGRESQL_PASSWORD_FILE=./secrets/postgresql_password
AUTHENTIK_SECRET_KEY_FILE=./secrets/authentik_secret_key

# These are identifiers, not credentials. Change only before first startup.
AUTHENTIK_POSTGRESQL_DATABASE=authentik
AUTHENTIK_POSTGRESQL_USER=authentik
